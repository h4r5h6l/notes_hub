# Production API image for Kubernetes / any non-Compose deployment.
# The simple development image stays in ./Dockerfile for docker compose.
FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

# Dependency layer first so source changes do not reinstall packages.
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Run as the image's built-in non-root "node" user (uid 1000).
COPY --chown=node:node src ./src
USER node

EXPOSE 5000
CMD ["node", "src/index.js"]
