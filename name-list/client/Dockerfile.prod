# Production frontend image: build the React bundle, serve it with Nginx.
# The simple development image stays in ./Dockerfile for docker compose.
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Unprivileged Nginx listens on 8080 and runs as uid 101, which lets the
# Kubernetes pod enforce runAsNonRoot.
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
