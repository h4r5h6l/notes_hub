# ---------------------------------------------------------------------------
# Copy this file to .env before running:
#   cp .env.example .env
# Never commit the real .env — it contains credentials.
# ---------------------------------------------------------------------------

# Compose project name (container / network naming prefix).
COMPOSE_PROJECT_NAME=namelist

# --- MongoDB ---------------------------------------------------------------
# Used by the official mongo image ONLY on the first boot of an empty volume.
# If you change these after the volume exists, either keep the old values or
# wipe the volume with: docker compose down -v
MONGO_INITDB_ROOT_USERNAME=namelist_admin
MONGO_INITDB_ROOT_PASSWORD=change_me_to_a_long_random_value
MONGO_INITDB_DATABASE=namelist

# Host port for optional access via MongoDB Compass (bound to 127.0.0.1).
MONGO_PORT=27017

# Connection string used by api-server inside the compose network.
# "db" is a network alias for the mongodb service.
# Keep the user/password/database in sync with the MONGO_INITDB_* values above;
# URL-encode special characters in the password (e.g. @ -> %40).
MONGO_URI=mongodb://namelist_admin:change_me_to_a_long_random_value@db:27017/namelist?authSource=admin

# --- API server ------------------------------------------------------------
# Host port. The container always listens on 5000 internally.
API_PORT=5000
# Browser origin allowed to call the API directly (CORS). Comma-separated if
# you serve the client from more than one origin.
CLIENT_ORIGIN=http://localhost:3000

# --- React app -------------------------------------------------------------
# Host port for the Vite dev server.
CLIENT_PORT=3000
# Internal address Vite uses to proxy /api requests. This is a container
# hostname, not something the browser ever resolves.
API_PROXY_TARGET=http://api-server:5000
